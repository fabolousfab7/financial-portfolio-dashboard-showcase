# Copy to .env for local server runs. All values below are placeholders.
# The demo runs fully without any of them.

# Bearer token expected by GET /api/cron/daily (Vercel Cron sends it automatically).
CRON_SECRET=replace-with-a-long-random-string

# Optional: enables live AI invoice extraction instead of the recorded demo response.
ANTHROPIC_API_KEY=

# Optional: Supabase persistence (see supabase/schema.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=
