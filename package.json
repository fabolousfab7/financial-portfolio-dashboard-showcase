{
  "name": "financial-portfolio-dashboard-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-account financial dashboard showcase: FIFO P&L, IBKR Flex XML parsing, historical FX, bank reconciliation, French VAT and AI invoice extraction. Demo data only.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:flex": "tsx demo/write-flex.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
